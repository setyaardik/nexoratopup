# Database (matches docker-compose.yml — run `docker compose up -d` first)
DATABASE_URL=postgresql://nexora:nexora@localhost:5432/nexora_game

# NextAuth
NEXTAUTH_SECRET=change_this_to_a_random_string
NEXTAUTH_URL=http://localhost:3000

# VIPayment H2H API (https://vip-reseller.co.id)
# sign = md5(api_id + api_key) per VIP-Reseller H2H convention — adjust in src/lib/vipayment.ts
# if your actual account documentation specifies a different signing scheme.
VIPAYMENT_API_URL=https://vip-reseller.co.id/api
VIPAYMENT_API_KEY=
VIPAYMENT_API_ID=
# Optional shared-secret token appended as ?token= on the VIPayment webhook URL
# you register (/api/transaction/callback) since VIPayment doesn't document a
# public signing scheme for it.
VIPAYMENT_WEBHOOK_TOKEN=

# Tripay Payment Gateway (https://tripay.co.id)
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_MODE=sandbox
# sandbox: https://tripay.co.id/api-sandbox | production: https://tripay.co.id/api

# WhatsApp Notification (optional, Fonnte)
FONNTE_API_KEY=

# Admin seed user (used by prisma/seed.ts)
ADMIN_EMAIL=admin@nexoragame.id
ADMIN_PASSWORD=Admin123!
